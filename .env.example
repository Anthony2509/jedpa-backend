#ENTORNO (development | production | test)
NODE_ENV=development

#PUERTO
PORT=4000

#CREDENCIALES BD
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=jedpa

#JWT (JWT_SECRET: mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=8h

#CORS
FRONTEND_URL=http://localhost:3000

#SEED (solo para `npm run seed`; la app no las necesita para arrancar)
#Contraseña de mínimo 12 caracteres. Tras el primer ingreso, cámbiela y borre estos valores.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

#CLOUD
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
