#ENTORNO (development | production | test)
NODE_ENV=development

#PUERTO (Railway lo asigna solo)
PORT=4000

#BASE DE DATOS
#Desarrollo (Docker): variables DB_*. Railway: basta DATABASE_URL (tiene prioridad).
#DATABASE_URL=postgresql://usuario:clave@host:5432/jedpa
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=jedpa
#true si el proveedor exige TLS por red pública
DB_SSL=false

#JWT (JWT_SECRET: mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=8h

#CORS: URL del frontend
FRONTEND_URL=http://localhost:3000

#Swagger (/docs): siempre activo fuera de producción; en producción solo con true
SWAGGER_ENABLED=false

#URL pública de esta API (base de los enlaces firmados de archivos locales)
API_PUBLIC_URL=http://localhost:4000

#Página del frontend que abre el QR (por defecto FRONTEND_URL/verificar)
VERIFY_PUBLIC_URL=http://localhost:3000/verificar
#Calibración de impresión de credenciales, en mm (positivo = derecha / abajo)
CREDENTIAL_OFFSET_X_MM=0
CREDENTIAL_OFFSET_Y_MM=0

#ARCHIVOS: local (desarrollo y pruebas) | cloudinary (privado, enlaces firmados)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
#Vigencia de los enlaces a documentos, en segundos
FILE_URL_TTL_SECONDS=300
#Tamaño máximo por archivo (5 MB)
UPLOAD_MAX_BYTES=5242880

#CLOUDINARY (obligatorias si STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=jedpa

#SOLO PRODUCCIÓN: administrador inicial que crea `npm run release` si aún no hay ninguno.
#Contraseña de 12+ caracteres con letras y números. Tras el primer despliegue puede quitarse.
#(En desarrollo el seed crea admin@, coordinador@ y operador@jedpa.local con password123.)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
